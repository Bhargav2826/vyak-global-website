# Example environment variables for the server
# Copy this file to .env and fill in your values
# NEVER commit the actual .env file to git

MONGO_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/vyakglobal?appName=Cluster0
PORT=5001
ADMIN_USERNAME=admin
ADMIN_PASSWORD=yourSecurePasswordHere
JWT_SECRET=yourRandomSecretKeyHere
